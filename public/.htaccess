# The PDF viewer's worker is a JavaScript module (.mjs): browsers refuse to run one sent as anything else.
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # The web cron (cron-job.org) is answered at once and the work goes on after that. LiteSpeed
    # stops PHP when the caller goes away, unless told not to (ignore_user_abort() is not enough).
    RewriteRule ^cron/run - [E=noabort:1,E=noconntimeout:1]

    # The system's documents — emails' PDFs and files, minutes and their signed copies — open only through
    # Wakeel, which asks who may see them (LegacyAttachmentPathController): never straight from the disk, even
    # while they are kept on this server.
    RewriteRule ^storage/(attachments|email-unfiled|email-replies)/ index.php [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
