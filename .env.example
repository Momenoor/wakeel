APP_NAME="Wakeel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=AED
APP_TIMEZONE=Asia/Muscat
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Seconds after which a queued job (QUEUE_CONNECTION=database) is given to a worker again: more than the
# longest job may run (300), or one still running is done twice. 330 when not set.
DB_QUEUE_RETRY_AFTER=3660
CACHE_STORE=database

# --- Chat / live broadcasting ---
# Local dev (this machine): BROADCAST_CONNECTION=reverb + `php artisan reverb:start`
#   running as a persistent process. Only works where you can run background
#   processes and open a custom port — never true on classic cPanel shared hosting.
# Shared hosting deploy: BROADCAST_CONNECTION=pusher. Pusher Channels is a managed
#   WebSocket service — Laravel just makes an outbound HTTPS call to it, and the
#   browser connects to Pusher's own servers, so nothing needs to run on your host.
#   Set PUSHER_APP_ID/KEY/SECRET/CLUSTER below; the panels read them at runtime
#   (config/filament.php), no `npm run build` needed. All four are required —
#   a missing secret stops the whole app from booting.
# A server of your own (VPS): BROADCAST_CONNECTION=reverb with `php artisan reverb:start`
#   kept running (Supervisor) and the web server passing /app and /apps to it; Pusher
#   details saved in Settings → Integrations are then left unused.
BROADCAST_CONNECTION=log

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the server hands each event to Reverb: by default 127.0.0.1:8080 over http, inside the machine.
# Set these only for a Reverb on another machine.
# REVERB_PUBLISH_HOST=
# REVERB_PUBLISH_PORT=
# REVERB_PUBLISH_SCHEME=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# VITE_BROADCAST_CONNECTION picks which block below the *frontend* build uses —
# set it to match BROADCAST_CONNECTION above, then rebuild (`npm run build`).
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Voice calls in the chat: the browsers find each other through STUN, and through the office's own TURN
# server (coturn, use-auth-secret) when they cannot reach each other directly — TURN_SECRET is coturn's
# static-auth-secret. Without TURN, calls between some networks do not connect.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302"
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bulk mail sender mailboxes (config/mail_senders.php) — SMTP/IMAP passwords.
MAIL_SENDER_IFLAS_PASSWORD=
MAIL_SENDER_HAIKALA_PASSWORD=
MAIL_SENDER_EASAR_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Microsoft Graph — calendar sync and outbound mail.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
MICROSOFT_CALENDAR_EMAIL=

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# WhatsApp notifications.
WHATSAPP_TOKEN=
WHATSAPP_FROM=
WHATSAPP_PHONE_ID=

# License — set by the installer's License step; INSTALLATION_ID is
# generated automatically, never typed by hand.
LICENSE_SERVER_URL=https://license.jpaemirates.com
# Other addresses of the same license server, tried when the first cannot be reached (comma-separated).
LICENSE_FALLBACK_URLS=https://license.jpaemirates.website
INSTALLATION_ID=

# Web cron trigger for hosts without a one-minute cron: an outside service
# calls /cron/run?token=CRON_TOKEN every minute. Create one with
# `php artisan cron:token`.
CRON_TOKEN=
# A server of your own that runs the scheduler by cron (`schedule:run` every minute)
# and queue workers (Supervisor): true turns the web cron link off and leaves queued
# work to the workers. Set QUEUE_CONNECTION=database with it.
SERVER_CRON=false
